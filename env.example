# ─────────────────────────────────────────────────────────────
# CloudCostMonitor — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# ── Your platform's AWS account ──────────────────────────────
# This is YOUR AWS account ID (not the customer's).
# Used in the CloudFormation template as PlatformAccountId.
PLATFORM_AWS_ACCOUNT_ID=your_platform_account_id_here

# ── Database ─────────────────────────────────────────────────
DB_URL=postgresql://costmonitor:password@localhost:5432/costmonitor

# ── Test account (for local development) ─────────────────────
# Use your own AWS account to test before onboarding customers.
TEST_ACCOUNT_ID=123456789012
TEST_ROLE_ARN=arn:aws:iam::123456789012:role/CloudCostMonitor-ReadOnly
TEST_EXTERNAL_ID=generate-a-random-uuid-here

# ── Alert channels ────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SENDGRID_API_KEY=SG.xxxxx

# ── App ───────────────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-string-here
ENVIRONMENT=development   # development | staging | production

# ── AI Agents ──────────────────────────────────────────────────
# Choose Claude (recommended) or OpenAI
AI_PROVIDER=claude          # claude | openai
CLAUDE_API_KEY=sk-ant-...
# OR
OPENAI_API_KEY=sk-...

AI_MODEL=claude-3-5-sonnet-20241022   # or gpt-4, gpt-4-turbo, etc
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# ── Caching ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Agent Scheduling ──────────────────────────────────────────
# Cron format: minute hour day_of_month month day_of_week
AGENT_SCHEDULE_ANOMALY=0 * * * *      # every hour
AGENT_SCHEDULE_FORECAST=0 2 * * *     # daily at 2am
AGENT_SCHEDULE_OPTIMIZER=0 3 * * 0    # weekly Sunday 3am
AGENT_SCHEDULE_REPORTER=0 8 * * 1     # weekly Monday 8am

# ── Rate limits ────────────────────────────────────────────────
AGENT_MAX_CONCURRENT=2
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=3
